{
  "name": "vMix UTC Replay",
  "description": "Coreografía convertida desde UTC de vMix: grabación + replay + marcador + exportación multicámara de los últimos 60 s (~111s + exportación secuencial de 4 cámaras)",
  "author": "VIB Automation",
  "version": "1.2",
  "events": [
    { "type": "Comment", "text": "=== Ocultar overlay y preparar video principal ===" },
    { "type": "OverlayInputXOut", "layer": 1 },
    { "type": "Timer", "ms": 500 },

    { "type": "Restart", "guid": "4aa1c3e6-8887-4688-baac-a05f77c312df", "comment": "Reiniciar video principal" },
    { "type": "CutDirect", "guid": "4aa1c3e6-8887-4688-baac-a05f77c312df", "layer": -1, "comment": "Cortar al video principal" },
    { "type": "Play", "guid": "4aa1c3e6-8887-4688-baac-a05f77c312df", "comment": "Reproducir video principal" },
    { "type": "StartRecording", "comment": "Iniciar grabación vMix" },
    { "type": "Timer", "ms": 2000 },

    { "type": "Comment", "text": "=== Iniciar grabación de replay ===" },
    { "type": "ReplayStartRecording" },
    { "type": "Timer", "ms": 14500 },

    { "type": "Comment", "text": "=== Activar marcador + overlay + marca replay in ===" },
    { "type": "ScriptStart", "script": "marcador", "comment": "Iniciar script marcador en vMix" },
    { "type": "OverlayInputXIn", "guid": "6c4f13c8-811f-4106-a268-258236dc7d9b", "layer": 1, "comment": "Mostrar overlay marcador" },
    { "type": "ReplayMarkIn", "comment": "Marcar punto de inicio del replay" },
    { "type": "Timer", "ms": 6000 },
    { "type": "Timer", "ms": 39000 },

    { "type": "Comment", "text": "=== Ocultar overlay + marca replay out ===" },
    { "type": "OverlayInputXOut", "layer": 1 },
    { "type": "Timer", "ms": 1000 },
    { "type": "ReplayMarkOut", "comment": "Marcar punto final del replay" },
    { "type": "Timer", "ms": 300 },

    { "type": "Comment", "text": "=== Configurar y detener replay ===" },
    { "type": "ReplaySelectLastEvent" },
    { "type": "ReplaySetSpeed", "speed": 60 },
    { "type": "ReplayStopRecording" },

    { "type": "Comment", "text": "=== Exportar replay multicámara (últimos 60 s, MP4 High Quality en vMix) ===" },
    { "type": "Comment", "text": "Primero se crean los 4 eventos juntos para que las ventanas de 60 s queden lo más alineadas posible" },
    { "type": "ReplayCamera", "camera": 1, "channel": "A", "comment": "Seleccionar Cámara 1 (queda seleccionada al final)" },
    { "type": "ReplayMarkInOut", "value": 60, "comment": "Crear evento Cam 1 (más antiguo, no se exporta)" },
    { "type": "ReplayCamera", "camera": 4, "channel": "A", "comment": "Seleccionar Cámara 4" },
    { "type": "ReplayMarkInOut", "value": 60, "comment": "Crear evento Cam 4" },
    { "type": "ReplayCamera", "camera": 3, "channel": "A", "comment": "Seleccionar Cámara 3" },
    { "type": "ReplayMarkInOut", "value": 60, "comment": "Crear evento Cam 3" },
    { "type": "ReplayCamera", "camera": 2, "channel": "A", "comment": "Seleccionar Cámara 2" },
    { "type": "ReplayMarkInOut", "value": 60, "comment": "Crear evento Cam 2 (el más reciente = 'last event')" },

    { "type": "Comment", "text": "vMix exporta de forma asíncrona e ignora un export nuevo mientras el anterior sigue codificando: se exporta el último evento, se espera al archivo y se borra el evento para que el anterior pase a ser el último" },
    { "type": "Comment", "text": "El export no lleva 'value': vMix usa su última carpeta de exportación (Replay → Export Clips). El 'folder' de WaitForExport debe ser esa misma carpeta" },
    { "type": "ReplayExportLastEvent", "comment": "Exportar Cam 2 (último evento)" },
    { "type": "WaitForExport", "folder": "C:/Users/TecnologíaIntegraTec/Desktop/27-10-2026 Mercedes Pista V 3.0.1", "timeout": 240000, "stable": 5000, "comment": "Esperar a que el MP4 de Cam 2 termine de escribirse" },
    { "type": "ReplayDeleteLastEvent", "comment": "Quitar el evento Cam 2 ya exportado" },
    { "type": "Timer", "ms": 1000 },

    { "type": "ReplayExportLastEvent", "comment": "Exportar Cam 3 (ahora es el último evento)" },
    { "type": "WaitForExport", "folder": "C:/Users/TecnologíaIntegraTec/Desktop/27-10-2026 Mercedes Pista V 3.0.1", "timeout": 240000, "stable": 5000, "comment": "Esperar a que el MP4 de Cam 3 termine de escribirse" },
    { "type": "ReplayDeleteLastEvent", "comment": "Quitar el evento Cam 3 ya exportado" },
    { "type": "Timer", "ms": 1000 },

    { "type": "ReplayExportLastEvent", "comment": "Exportar Cam 4 (ahora es el último evento)" },
    { "type": "WaitForExport", "folder": "C:/Users/TecnologíaIntegraTec/Desktop/27-10-2026 Mercedes Pista V 3.0.1", "timeout": 240000, "stable": 5000, "comment": "Esperar a que el MP4 de Cam 4 termine de escribirse" },
    { "type": "ReplayDeleteLastEvent", "comment": "Quitar el evento Cam 4 ya exportado" },
    { "type": "Timer", "ms": 1000 },

    { "type": "ReplaySelectLastEvent", "comment": "Dejar seleccionado el evento de Cámara 1" },

    { "type": "ScriptStop", "script": "marcador", "comment": "Detener script marcador en vMix" },

    { "type": "Comment", "text": "=== Reproducir bumper/replay y finalizar ===" },
    { "type": "QuickPlay", "guid": "24770592-adde-40ea-aa27-231d7b7bd61a", "comment": "Reproducir replay/bumper" },
    { "type": "Timer", "ms": 48000 },
    { "type": "StopRecording", "comment": "Detener grabación vMix" }
  ]
}
