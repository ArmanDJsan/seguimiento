{
  "videohub": {
    "ip": "192.168.1.50",
    "port": 9990
  },
  "esp32": {
    "ip": "192.168.88.114",
    "port": 80,
    "endpoints": {
      "test": "/test",
      "iniciar": "/iniciar",
      "cerrar": "/cerrar",
      "recargar": "/recargar"
    }
  },
  "redis": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 6379
  },
  "yolo": {
    "enabled": true,
    "model_path": "models/yolov8n.engine",
    "fallback": "stub",
    "batch_size": 4,
    "confidence_threshold": 0.5,
    "nms_threshold": 0.4,
    "use_fp16": true
  },
  "camera_selector": {
    "enabled": true,
    "top_k": 4,
    "motion_threshold": 0.05,
    "edge_handover_margin": 0.1
  },
  "detection_optimization": {
    "hysteresis": {
      "switch_threshold": 0.15,
      "min_active_frames": 10,
      "decay_factor": 0.98
    }
  },
  "mega_canvas": {
    "enabled": true,
    "description": "16K Virtual Canvas for vMix WGC capture",
    "grid_layout": {
      "columns": 4,
      "rows": 3
    },
    "cell_resolution": {
      "width": 3840,
      "height": 2160,
      "description": "Native 4K per cell for maximum quality"
    },
    "canvas_resolution": {
      "width": 15360,
      "height": 6480,
      "description": "Total 16K virtual resolution (4x3 grid)"
    },
    "tensorrt": {
      "width": 640,
      "height": 640,
      "high_priority_stream": true,
      "description": "Downscaled buffer for YOLO inference - uses separate stream"
    },
    "presentation": {
      "flip_model": true,
      "vsync": false,
      "tearing_allowed": true,
      "max_frame_latency": 1,
      "description": "DXGI_SWAP_EFFECT_FLIP_DISCARD for DWM bypass"
    },
    "window": {
      "borderless": true,
      "no_redirection_bitmap": true,
      "topmost": false,
      "x": 0,
      "y": 0,
      "description": "WS_POPUP + WS_EX_NOREDIRECTIONBITMAP for optimal WGC capture"
    },
    "hidden_mode": {
      "enabled": true,
      "mouse_passthrough": true,
      "hide_from_taskbar": true,
      "exclude_from_standard_capture": false,
      "virtual_coordinates": {
        "x": -15360,
        "y": 0
      },
      "description": "Ghost window mode - positioned off-screen at -15360,0 for vMix WGC detection. exclude_from_standard_capture=false recommended to avoid vMix issues."
    },
    "fallback_to_ndi": false
  },
  "performance_optimization": {
    "cpu_affinity": {
      "enabled": true,
      "capture_threads_cores": "2-3",
      "processing_threads_cores": "4-5",
      "tensorrt_cores": "8-11",
      "render_thread_core": "12",
      "atlas_compositor_core": "13",
      "description": "CCD0 for video capture, CCD1 for render/AI to minimize inter-CCD latency"
    },
    "gpu_scheduling": {
      "hardware_accelerated_scheduling": "required",
      "check_on_startup": true,
      "pcie_bandwidth_monitoring": true,
      "description": "Requires Windows Hardware Accelerated GPU Scheduling enabled in Graphics Settings"
    },
    "cuda_optimization": {
      "multi_buffering_ndi": true,
      "event_pooling": false,
      "stream_priority_high": true,
      "vram_bifurcation": true,
      "description": "Enable multi-buffering and VRAM bifurcation for Atlas + TensorRT"
    },
    "telemetry_targets": {
      "cap_max_ms": 15.0,
      "sel_max_ms": 5.0,
      "ndi_max_ms": 10.0,
      "canvas_max_ms": 5.0,
      "present_max_ms": 2.0,
      "total_max_ms": 32.0,
      "description": "Performance KPIs - total must be <33.3ms for 30fps"
    }
  },
  "ports": [
    { "index": 1, "name": "CAM_01", "role": "stream", "is_output": true },
    { "index": 2, "name": "CAM_02", "role": "stream" },
    { "index": 3, "name": "CAM_03", "role": "stream" },
    { "index": 4, "name": "CAM_04", "role": "stream" },
    { "index": 5, "name": "CAM_05", "role": "stream" },
    { "index": 6, "name": "CAM_06", "role": "stream" },
    { "index": 7, "name": "CAM_07", "role": "stream" },
    { "index": 8, "name": "CAM_08", "role": "stream" },
    { "index": 9, "name": "CAM_09", "role": "stream" },
    { "index": 10, "name": "CAM_10", "role": "stream" },
    { "index": 11, "name": "CAM_11", "role": "stream" },
    { "index": 12, "name": "CAM_12", "role": "stream" },
    { "index": 13, "name": "RADAR_01", "role": "radar" },
    { "index": 14, "name": "RADAR_02", "role": "radar" },
    { "index": 15, "name": "RADAR_03", "role": "radar" },
    { "index": 16, "name": "RADAR_04", "role": "radar" }
  ],
  "target_spheres": 10
}
