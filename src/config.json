{
  "videohub": {
    "ip": "192.168.1.50",
    "port": 9990
  },
  "esp32": {
    "ip": "192.168.88.114",
    "port": 80,
    "endpoints": {
      "test": "/test",
      "iniciar": "/iniciar",
      "cerrar": "/cerrar",
      "recargar": "/recargar"
    }
  },
  "redis": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 6379
  },
  "camera_selector": {
    "enabled": true,
    "top_k": 4,
    "motion_threshold": 0.05,
    "edge_handover_margin": 0.1
  },
  "detection_optimization": {
    "hysteresis": {
      "switch_threshold": 0.15,
      "min_active_frames": 10,
      "decay_factor": 0.98
    }
  },
  "performance_optimization": {
    "cpu_affinity": {
      "enabled": true,
      "capture_threads_cores": "0-3",
      "processing_threads_cores": "4-7",
      "description": "Pin video threads to CCD0 (cores 0-7) to avoid inter-CCD latency on Threadripper"
    },
    "gpu_scheduling": {
      "hardware_accelerated_scheduling": "required",
      "check_on_startup": true,
      "pcie_bandwidth_monitoring": true,
      "description": "Requires Windows Hardware Accelerated GPU Scheduling enabled in Graphics Settings"
    },
    "cuda_optimization": {
      "multi_buffering_ndi": true,
      "event_pooling": false,
      "stream_priority_high": true,
      "description": "Enable multi-buffering for NDI to reduce GPU->CPU transfer blocking"
    },
    "telemetry_targets": {
      "cap_max_ms": 15.0,
      "sel_max_ms": 5.0,
      "ndi_max_ms": 10.0,
      "total_max_ms": 32.0,
      "description": "Performance KPIs under high motion (Avg motion > 0.5)"
    }
  },
  "scene_manager": {
    "enabled": true,
    "mute_timeout_ms": 200,
    "mode": "auto",
    "manual_keys": {
      "toggle_mode": "M",
      "config_select": ["F1", "F6", "F7"],
      "group_select": "G",
      "camera_select": ["1", "2", "3", "4"]
    },
    "groups": {
      "config_a": {
        "g1_g4": [1, 2, 3, 12],
        "g5_g8": [4, 5, 6, 7],
        "trigger_threshold": 25.0,
        "description": "Initial config - cameras 1-3,12 in G1-G4, cameras 4-7 in G5-G8"
      },
      "config_b": {
        "g1_g4": [8, 9, 10, 12],
        "g5_g8": [4, 5, 6, 7],
        "trigger_threshold": 50.0,
        "description": "Mid-track config - cameras 8-10,12 in G1-G4"
      },
      "config_c": {
        "g1_g4": [8, 9, 10, 12],
        "g5_g8": [11, 1, 2, 3],
        "trigger_threshold": 75.0,
        "description": "Late-track config - rotates G5-G8 to finish line cameras"
      }
    }
  },
  "inference_engine": {
    "model_path": "models/yolo26l_fp16_batch12.engine",
    "batch_size": 12,
    "precision": "FP16",
    "input_size": 640,
    "nms_threshold": 0.4,
    "confidence_threshold": 0.6,
    "num_classes": 10,
    "description": "TensorRT engine for ball detection"
  },
  "position_mapper": {
    "calibration_file": "config/calibration.json",
    "track_bounds": {
      "x_min": 0.0,
      "x_max": 100.0,
      "y_min": 0.0,
      "y_max": 6.0
    },
    "description": "Homography-based pixel to global coordinate transformation"
  },
  "ball_tracker": {
    "num_balls": 10,
    "kalman_process_noise_pos": 0.01,
    "kalman_process_noise_vel": 0.1,
    "kalman_measurement_noise": 0.5,
    "max_occlusion_frames": 30,
    "association_gate_distance": 2.0,
    "min_confidence_threshold": 0.3,
    "description": "Kalman filter-based multi-ball tracking with Hungarian assignment"
  },
  "ranking_publisher": {
    "enabled": true,
    "vmix_host": "127.0.0.1",
    "vmix_tcp_port": 8099,
    "publish_rate_hz": 30,
    "title_input_name": "RankingTitle",
    "description": "Publish ball rankings to vMix GT Titles"
  },
  "choreography": {
    "enabled": true,
    "script_path": "config/choreography/carrera_principal.json",
    "auto_start": false,
    "continue_on_error": true,
    "vmix_required": false,
    "trigger_key": "F12",
    "debug": false,
    "description": "vMix choreography automation - executes sequences of vMix commands and NDI slot changes"
  },
  "ports": [
    { "index": 1, "name": "CAM_01", "role": "stream", "is_output": true },
    { "index": 2, "name": "CAM_02", "role": "stream" },
    { "index": 3, "name": "CAM_03", "role": "stream" },
    { "index": 4, "name": "CAM_04", "role": "stream" },
    { "index": 5, "name": "CAM_05", "role": "stream" },
    { "index": 6, "name": "CAM_06", "role": "stream" },
    { "index": 7, "name": "CAM_07", "role": "stream" },
    { "index": 8, "name": "CAM_08", "role": "stream" },
    { "index": 9, "name": "CAM_09", "role": "stream" },
    { "index": 10, "name": "CAM_10", "role": "stream" },
    { "index": 11, "name": "CAM_11", "role": "stream" },
    { "index": 12, "name": "CAM_12", "role": "stream" },
    { "index": 13, "name": "RADAR_01", "role": "radar" },
    { "index": 14, "name": "RADAR_02", "role": "radar" },
    { "index": 15, "name": "RADAR_03", "role": "radar" },
    { "index": 16, "name": "RADAR_04", "role": "radar" }
  ],
  "target_spheres": 10
}
